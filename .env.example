# ---------------------------------------------------------------------------
# OPT-MUS yapilandirmasi. Bu dosyayi `.env` olarak kopyalayip doldurun.
# ---------------------------------------------------------------------------

PORT=3000

# Saglayici: anthropic | openai | ollama | mock
#   anthropic -> Claude API
#   openai    -> OpenAI ve OpenAI-uyumlu her sey (OpenRouter, Together, Groq,
#                DeepSeek, vLLM, LM Studio ... ve kendi egittiginiz model)
#   ollama    -> yerelde calisan Ollama
#   mock      -> API anahtari olmadan denemek icin sahte saglayici
LLM_PROVIDER=anthropic

# --- anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- openai / openai-uyumlu ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Kendi egittiginiz modeli (training/serve_openai.py) kullanmak icin:
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:8000/v1
#   OPENAI_MODEL=optmus-coder
#   OPENAI_API_KEY=local

# --- ollama ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Uretim ayarlari
MAX_TOKENS=16000
TEMPERATURE=0.4

# Egitim verisi toplama: her uretim training/data/ altina kaydedilir
COLLECT_DATASET=true
