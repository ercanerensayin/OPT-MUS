# ---- Beyin (zorunlu) -------------------------------------------------------
# Sohbet, kod yazma, oyun/uygulama üretme, video senaryosu planlama hep buradan.
ANTHROPIC_API_KEY=sk-ant-...
OPTIMUS_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (kod/ajan işleri için xhigh önerilir)
OPTIMUS_EFFORT=high

# ---- Görsel üretimi --------------------------------------------------------
# demo | openai | stability | replicate
IMAGE_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# ---- Video üretimi ---------------------------------------------------------
# demo | replicate | luma
# demo = API anahtarı olmadan, ffmpeg ile yerel placeholder klipler üretir.
#        Sınırsız süreli birleştirme hattını anahtarsız test etmek için.
VIDEO_PROVIDER=demo
REPLICATE_VIDEO_MODEL=minimax/video-01
LUMA_API_KEY=
# Tek seferde modelin üretebildiği maksimum klip süresi (saniye).
# Uzun videolar bu uzunlukta parçalara bölünüp birleştirilir.
VIDEO_SEGMENT_SECONDS=5

# ---- Çalışma alanı ---------------------------------------------------------
OPTIMUS_WORKSPACE=./workspace
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
OPTIMUS_HOST=127.0.0.1
OPTIMUS_PORT=8000
